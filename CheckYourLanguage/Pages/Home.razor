@page "/"
@using System.Net.Http.Json
@using CheckYourLanguage.Game
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Check Your Language</PageTitle>

<main class="game">
    <header class="topbar">
        <h1>Check Your <span>Language</span></h1>
        <div class="toolbar">
            @if (_game is not null)
            {
                <button class="icon-btn text-btn @(_game.AlwaysText ? "on" : "")" @onclick="ToggleAlwaysText"
                        aria-pressed="@_game.AlwaysText"
                        title="@(_game.AlwaysText ? "Always showing the text: click to hide it until asked for" : "Always show the text")"
                        aria-label="Always show the text">Aa</button>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="play"><section class="intro"><p>@_error</p></section></div>
    }
    else if (_game is null)
    {
        <div class="play"><section class="intro"><p class="muted">Loading the phrases…</p></section></div>
    }
    else
    {
        var languages = _game.Book.Languages;
        <div class="pickers" style="--count:@languages.Count">
            <span class="row-label">Hear</span>
            <nav class="langs" aria-label="First language">
                @foreach (var lang in languages)
                {
                    <button class="lang-chip @(lang == _game.From ? "on" : "")" aria-pressed="@(lang == _game.From)"
                            title="@lang.Native" aria-label="First: @lang.Native" @onclick="() => SetFrom(lang)">
                        <img class="flag" src="@lang.FlagFile" alt="" draggable="false" />
                    </button>
                }
            </nav>
            <button class="swap-btn" @onclick="Swap" title="Swap the two languages" aria-label="Swap the two languages">⇅</button>
            <span class="row-label">Then</span>
            <nav class="langs" aria-label="Second language">
                @foreach (var lang in languages)
                {
                    <button class="lang-chip to @(lang == _game.To ? "on" : "")" aria-pressed="@(lang == _game.To)"
                            title="@lang.Native" aria-label="Then: @lang.Native" @onclick="() => SetTo(lang)">
                        <img class="flag" src="@lang.FlagFile" alt="" draggable="false" />
                    </button>
                }
            </nav>
        </div>

        <div class="play">
            @if (_game.Current is null)
            {
                <section class="intro">
                    <span class="eyebrow">@_game.From.Name → @_game.To.Name · @_game.Book.Count phrases</span>
                    <p>Hear an everyday phrase in <strong><em>@_game.From.Name</em></strong>. Work out what it means
                        or how you would say it, then hear it in <strong><em>@_game.To.Name</em></strong>.</p>
                    <p class="muted">
                        The text stays hidden until you ask for it (or switch on <strong>Aa</strong> to always see it).
                        <span class="on-keys"><kbd>Space</kbd> plays it again, <kbd>T</kbd> shows the text and
                            <kbd>Enter</kbd> moves on.</span>
                    </p>
                    @* Browsers only allow sound after a user gesture, so the first phrase waits for this one. *@
                    <button class="primary-btn" @onclick="NextPhrase">Start <kbd>Enter</kbd></button>
                </section>
            }
            else
            {
                var translated = _game.Stage == Stage.Translated;
                <span class="eyebrow counter">Phrase @_game.Seen of @_game.Book.Count</span>

                <section class="phrase from" @key="@($"from-{_round}")">
                    <button class="orb @(_playing == Side.From ? "playing" : "")" @onclick="() => Play(Side.From)"
                            aria-label="Play it again in @_game.From.Name" title="Play it again (Space)">
                        <SpeakerIcon />
                    </button>
                    <div class="phrase-body">
                        <span class="lang-name"><img class="flag" src="@_game.From.FlagFile" alt="" />@_game.From.Name</span>
                        @if (_game.FromTextShown)
                        {
                            <span class="phrase-text">@_game.FromText</span>
                        }
                        else
                        {
                            <button class="text-reveal" @onclick="_game.ShowFromText">Show text <kbd class="on-keys">T</kbd></button>
                        }
                    </div>
                </section>

                <div class="arrow" aria-hidden="true">↓</div>

                <section class="phrase to @(translated ? "" : "waiting")" @key="@($"to-{_round}")">
                    @if (translated)
                    {
                        <button class="orb @(_playing == Side.To ? "playing" : "")" @onclick="() => Play(Side.To)"
                                aria-label="Play it again in @_game.To.Name" title="Play it again (Space)">
                            <SpeakerIcon />
                        </button>
                        <div class="phrase-body">
                            <span class="lang-name"><img class="flag" src="@_game.To.FlagFile" alt="" />@_game.To.Name</span>
                            @if (_game.ToTextShown)
                            {
                                <span class="phrase-text">@_game.ToText</span>
                            }
                            else
                            {
                                <button class="text-reveal" @onclick="_game.ShowToText">Show text <kbd class="on-keys">T</kbd></button>
                            }
                        </div>
                    }
                    else
                    {
                        <button class="hear-btn" @onclick="Translate">
                            <img class="flag" src="@_game.To.FlagFile" alt="" />
                            <span>Hear it in @_game.To.Name</span>
                            <kbd class="on-keys">Enter</kbd>
                        </button>
                    }
                </section>

                <div class="next-row">
                    @if (translated)
                    {
                        <button class="primary-btn" @onclick="NextPhrase">Next phrase <kbd class="on-keys">Enter</kbd></button>
                    }
                    else
                    {
                        <button class="ghost-btn" @onclick="NextPhrase" title="Skip to the next phrase">Skip</button>
                    }
                </div>
            }
        </div>
    }

    <footer class="credits">Made with love 💛 (c) 2026 Per Hejndorf, Kreaton · Voices are computer-generated<span class="build"> – @BuildInfo.Display</span></footer>
</main>

@code {
    private const string StateKey = "checkyourlanguage.state";

    private enum Side { None, From, To }

    private PhraseGame? _game;
    private string? _error;
    private DotNetObjectReference<Home>? _self;
    private Side _playing;
    private Side _lastPlayed = Side.From;
    private int _sayToken;
    private int _round;

    private sealed record SavedState(string From, string To, bool AlwaysText);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<PhraseData>("phrases.json");
            var book = new PhraseBook(data ?? throw new InvalidOperationException("phrases.json is empty."));
            if (book.Languages.Count < 2 || book.Count == 0) throw new InvalidOperationException("phrases.json has too few languages or phrases.");
            _game = new PhraseGame(book);
            // Danish to English until something else is chosen.
            _game.SetFrom(book.Get("da", _game.From));
            _game.SetTo(book.Get("en", _game.To));
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException)
        {
            _error = "The phrases could not be loaded. Reload the page to try again.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_game is null || _self is not null) return;

        var json = await JS.InvokeAsync<string?>("gameStore.load", StateKey);
        if (json is not null)
        {
            try
            {
                if (System.Text.Json.JsonSerializer.Deserialize<SavedState>(json) is { } saved)
                {
                    _game.AlwaysText = saved.AlwaysText;
                    _game.SetFrom(_game.Book.Get(saved.From, _game.From));
                    _game.SetTo(_game.Book.Get(saved.To, _game.To));
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // A broken saved state just starts from scratch.
            }
        }
        StateHasChanged();

        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("gameKeys.attach", _self);
    }

    [JSInvokable]
    public async Task OnKey(string key)
    {
        if (_game is null) return;
        if (_game.Current is null)
        {
            if (key is "Enter" or " ") NextPhrase();
        }
        else if (key == " ")
        {
            await Play(_lastPlayed);
        }
        else if (key == "Enter")
        {
            if (_game.Stage == Stage.Heard) Translate();
            else NextPhrase();
        }
        else if (key is "t" or "T")
        {
            _game.ShowText();
        }
        else if (key == "1")
        {
            await Play(Side.From);
        }
        else if (key == "2" && _game.Stage == Stage.Translated)
        {
            await Play(Side.To);
        }
        StateHasChanged();
    }

    private async Task SetFrom(Language language)
    {
        _game!.SetFrom(language);
        await LanguagesChanged();
    }

    private async Task SetTo(Language language)
    {
        _game!.SetTo(language);
        await LanguagesChanged();
    }

    private async Task Swap()
    {
        _game!.Swap();
        await LanguagesChanged();
    }

    /// <summary>A new pair starts over with a fresh phrase in the new first language, once the game has started.</summary>
    private async Task LanguagesChanged()
    {
        if (_game!.Current is not null) NextPhrase();
        await SaveState();
    }

    private async Task ToggleAlwaysText()
    {
        _game!.AlwaysText = !_game.AlwaysText;
        if (_game.AlwaysText) _game.ShowText();
        await SaveState();
    }

    private void NextPhrase()
    {
        if (_game is null) return;
        _game.NextPhrase();
        _round++;
        _ = Play(Side.From);
        if (_game.Upcoming is { } next) _ = JS.InvokeVoidAsync("voice.preload", _game.Book.Audio(next, _game.From)).AsTask();
        _ = JS.InvokeVoidAsync("voice.preload", _game.ToAudio).AsTask();
    }

    private void Translate()
    {
        if (_game is null || _game.Stage != Stage.Heard) return;
        _game.Translate();
        if (_game.AlwaysText) _game.ShowToText();
        _ = Play(Side.To);
    }

    private async Task Play(Side side)
    {
        if (_game?.Current is null || side == Side.None) return;
        if (side == Side.To && _game.Stage != Stage.Translated) return;
        var url = side == Side.From ? _game.FromAudio : _game.ToAudio;
        var token = ++_sayToken;
        _lastPlayed = side;
        _playing = side;
        StateHasChanged();
        try
        {
            await JS.InvokeAsync<bool>("voice.play", url);
        }
        catch (JSException)
        {
            // No audio: the phrase can still be read.
        }
        if (token != _sayToken) return;
        _playing = Side.None;
        StateHasChanged();
    }

    private async Task SaveState()
    {
        if (_game is null) return;
        var json = System.Text.Json.JsonSerializer.Serialize(new SavedState(_game.From.Code, _game.To.Code, _game.AlwaysText));
        await JS.InvokeVoidAsync("gameStore.save", StateKey, json);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("gameKeys.detach");
        }
        catch (JSDisconnectedException)
        {
        }
        _self?.Dispose();
    }
}
